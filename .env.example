# --- OpenAI ---
# Required. The system fails fast with a clear message if this is unset.
OPENAI_API_KEY=sk-...

# Model IDs are pinned here, in one place. Verify against the current OpenAI
# model list before changing; do not guess IDs.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# --- Database ---
DATABASE_URL=postgresql+psycopg://policy:policy@localhost:5433/policy_intelligence

# --- Storage ---
STORAGE_DIR=./storage

# --- Ingestion limits (see docs: upload validation) ---
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=600
OCR_MIN_CHARS_PER_PAGE=50

# --- Retrieval ---
# vector | keyword | bm25 | hybrid | hybrid_bm25
# bm25 and hybrid_bm25 exist for the experiment table, not for serving.
# Default is vector because the benchmark says so, not because it is simpler --
# hybrid measured worse at rank 1. See docs/experiments.md.
RETRIEVAL_MODE=vector
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
RRF_K=60

# Needs the optional extra: uv pip install -e ".[rerank]"
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Compared against a cosine similarity, never against the active ranking score.
ABSTAIN_SEMANTIC_THRESHOLD=0.25

# --- Dev tenant (week 1: auth is stubbed, isolation is not) ---
DEV_TENANT_SLUG=dev
