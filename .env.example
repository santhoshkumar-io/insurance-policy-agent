# --- OpenAI ---
# Required. The system fails fast with a clear message if this is unset.
OPENAI_API_KEY=sk-...

# Model IDs are pinned here, in one place. Verify against the current OpenAI
# model list before changing; do not guess IDs.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# --- Database ---
DATABASE_URL=postgresql+psycopg://policy:policy@localhost:5433/policy_intelligence

# --- Storage ---
# None. Uploaded PDFs are stored in the database next to the row that describes them,
# because a deployed host's filesystem does not survive a redeploy and re-indexing needs
# the original file. See rag/storage.py.

# --- Ingestion limits (see docs: upload validation) ---
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=600
OCR_MIN_CHARS_PER_PAGE=50

# --- Retrieval ---
# vector | keyword | bm25 | hybrid | hybrid_bm25
# Default is hybrid_bm25 because the benchmark says so: Recall@5 = 1.000 on the real
# corpus against vector's 0.950, at ~5ms warm once the scoped index is cached.
# The single-arm rows (keyword, bm25) exist for the experiment table, not for serving.
RETRIEVAL_MODE=hybrid_bm25
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
RRF_K=60

# Needs the optional extra: uv pip install -e ".[rerank]"
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Compared against a cosine similarity, never against the active ranking score.
ABSTAIN_SEMANTIC_THRESHOLD=0.25

# How many scoped BM25 indexes each worker keeps in memory.
BM25_CACHE_SIZE=8

# Section metadata as a tie-breaker. Measured and rejected -- see docs/decisions.md.
SECTION_TIEBREAK_ENABLED=false
SECTION_TIEBREAK_TOLERANCE=0.15

# --- Dev tenant (week 1: auth is stubbed, isolation is not) ---
DEV_TENANT_SLUG=dev

# --- Demo ceilings (an open deployment has no auth in front of a paid key) ---
# Set any of these to 0 to disable that check.
RATE_LIMIT_QUESTIONS_PER_MINUTE=10
RATE_LIMIT_UPLOADS_PER_MINUTE=3
DAILY_QUESTION_CAP=300

# --- Dashboard ---
# Browser origins allowed to call the API, as a JSON list. Not "*".
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
